# ═══════════════════════════════════════════════════════════
# StrawCRM Global .gitignore - Security & Secrets Policy
# ═══════════════════════════════════════════════════════════

# Environment variables & secrets
.env
.env.*
*.env
!.env.example
*.local

# Secrets, Service Accounts & Private Keys
*serviceAccount*.json
*service_account*.json
*credentials*.json
*firebase-admin*.json
*firebase_admin*.json
*.pem
*.key
*.pfx
*.p12
*.crt
*.cert

# Local Runtime Data & Uploads
uploads/
**/uploads/*
!**/uploads/.gitkeep
data/*.json
data/*_backup.json
**/data/*.json
*.bin
*.meta.json

# Dependencies
node_modules/
**/node_modules/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/

# Build artifacts & caches
dist/
build/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Brain & Agent scratch artifacts
.tempmediaStorage/
.user_uploaded/
scratch/
