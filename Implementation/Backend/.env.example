# StrawCRM Backend Environment Configuration Example
# Copy this file to .env and populate with your credentials

ENVIRONMENT=development
PROJECT_NAME=StrawCRM API
FIREBASE_PROJECT_ID=your-firebase-project-id
FRONTEND_URL=http://localhost:5173

# Google Gemini AI Service
GEMINI_API_KEY=your_gemini_api_key_here

# Brevo HTTPS REST API (Optional)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_email@example.com
BREVO_SENDER_NAME=StrawCRM Notifications

# Resend HTTPS REST API (Optional)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=StrawCRM <onboarding@resend.dev>

# Gmail / SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_FROM_NAME=StrawCRM Support
